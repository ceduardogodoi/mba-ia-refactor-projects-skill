# Copie para .env e ajuste. O arquivo .env não deve ser commitado.

# Obrigatória — a aplicação não sobe sem ela.
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-valor-aleatorio

# Modo debug do Flask. Nunca use true fora do ambiente local: o Werkzeug expõe
# um console interativo na página de traceback.
DEBUG=false

DB_PATH=loja.db

HOST=127.0.0.1
PORT=5000

LOG_LEVEL=INFO

# Origens permitidas para CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# Limite do corpo das requisições, em bytes. Sem isto, um JSON grande o bastante
# esgota a memória do processo.
MAX_CONTENT_LENGTH_BYTES=1048576

# Rate limit do /login: tentativas por janela, por IP de origem. O contador vive
# em memória, então com mais de um worker o limite efetivo é multiplicado pelo
# número de workers — ver src/middlewares/rate_limit.py.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Habilita POST /admin/query e POST /admin/reset-db. Enquanto false, as duas
# rotas continuam existindo e respondem 403. Ligar significa expor execução de
# SQL arbitrário e destruição de dados — faça isso apenas em ambiente local.
ADMIN_ENDPOINTS_ENABLED=false

# Carrega produtos e usuários de exemplo quando o banco está vazio.
SEED_ON_BOOT=true
