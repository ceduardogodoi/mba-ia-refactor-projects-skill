# Copie para .env e ajuste. O arquivo .env não deve ser commitado.

# Obrigatória — a aplicação não sobe sem ela.
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-valor-aleatorio

# Nunca true fora do ambiente local: o Werkzeug expõe um console interativo na
# página de traceback.
DEBUG=false

DATABASE_URI=sqlite:///tasks.db

HOST=127.0.0.1
PORT=5000

LOG_LEVEL=INFO

# Origens permitidas para CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# Limite do corpo das requisições, em bytes.
MAX_CONTENT_LENGTH_BYTES=1048576

# Notificações por email. Desligadas por padrão — no projeto original o serviço
# existia mas nunca era chamado, e enviar email de dentro de um handler HTTP
# precisa de decisão consciente.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
