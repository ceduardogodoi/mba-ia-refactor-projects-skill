# Copie para .env e ajuste. O arquivo .env não deve ser commitado.

# Obrigatória — a aplicação não sobe sem ela.
# A chave que estava hardcoded no código foi comprometida e precisa ser revogada.
PAYMENT_GATEWAY_KEY=pk_test_troque_por_uma_chave_de_teste

NODE_ENV=development

# Host explícito. O código original escutava em todas as interfaces, o que expõe
# na rede local uma API sem autenticação.
HOST=127.0.0.1
PORT=3000

# ':memory:' recria o banco a cada boot, com seed. Aponte para um arquivo para
# ter persistência.
DATABASE_FILE=:memory:
SEED_ON_BOOT=true

LOG_LEVEL=info

# Limite do corpo das requisições. Sem isto, um JSON grande o bastante esgota a
# memória do processo.
MAX_BODY_SIZE=100kb

CACHE_MAX_ENTRIES=1000
